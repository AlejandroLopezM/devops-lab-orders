{
  "name": "devops-lab-orders",
  "version": "1.0.0",
  "description": "Aplicación web de gestión de pedidos - Laboratorio técnico DevOps U2",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "test:ci": "jest --coverage --coverageReporters=text --coverageReporters=lcov --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 70,
        "branches": 60
      }
    }
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
